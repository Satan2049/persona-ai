# Contact numbers shared in the psychologist prompt and high-risk escalation replies
SOCIAL_EMERGENCY_NUMBER=123
RESEARCHER_NUMBER=09373759943

# OpenAI-compatible chat API (Ollama, vLLM, cloud gateway, etc.)
MODEL_API_BASE=http://127.0.0.1:11434/v1
MODEL_API_KEY=api-key
MODEL_NAME=your-chat-model
MODEL_TIMEOUT_SECONDS=25
MODEL_MAX_RETRIES=3
MODEL_TEMPERATURE=0.5
# Max completion tokens (shorter replies). Set to 0 to omit max_tokens for the API.
MODEL_MAX_TOKENS=380

# OpenAI-compatible TTS (POST {base}/audio/speech). Omit TTS_* to reuse MODEL_*.
# TTS_API_BASE=https://api.openai.com/v1
# TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE_FA=shimmer
TTS_VOICE_EN=alloy
TTS_TIMEOUT_SECONDS=30

# OpenAI-compatible STT → POST {STT_API_BASE}/audio/transcriptions
# GapGPT example: STT_API_BASE=https://api.gapgpt.app/v1  →  .../v1/audio/transcriptions
# STT_API_BASE=https://api.openai.com/v1
# STT_API_KEY=
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=45

# Rhubarb Lip Sync (audio → mouth cues). Default: tools/rhubarb/rhubarb.exe
# RHUBARB_PATH=../../tools/rhubarb/rhubarb.exe
RHUBARB_TIMEOUT_SECONDS=60

AUDIO_OUTPUT_DIR=../../audio
# Prefer absolute AppData in desktop installs; relative paths are resolved from apps/backend/
# AUDIO_OUTPUT_DIR=C:/Users/You/AppData/Roaming/PersonaAI/audio

# FAQ style examples (bundled; optional override)
# FAQ_PATH=../../data/faq_dataset.json

# Avatar voice → face age mapping
VOICE_AVATAR_MAP_PATH=../../assets/config/voice_avatar_map.json

# Where data goes after desktop install: docs/desktop-data-layout.md

# Desktop sidecar (set by Tauri shell; optional for manual runs)
# PERSONA_HOST=127.0.0.1
# PERSONA_PORT=8000
# PERSONA_DATA_DIR=
